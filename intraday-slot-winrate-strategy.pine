//@version=6
strategy("時間帯別戦略", overlay=true, max_bars_back=5000, default_qty_type=strategy.fixed, default_qty_value=100, margin_long=0, margin_short=0)

lookbackMinCount = input.int(3, "最低サンプル日数(全期間判定用)", minval=1)
flatAtClose      = input.bool(true, "大引け前に手仕舞い")
showTable        = input.bool(true, "スロット別成績表示")

if timeframe.period != "30"
    runtime.error("30分足専用")

morningStart   = 9*60+0
morningEnd     = 11*60+30
afternoonStart = 12*60+30
afternoonEnd   = 15*60+30
morningSlots   = int((morningEnd - morningStart) / 30)
afternoonSlots = int((afternoonEnd - afternoonStart) / 30)
totalSlots     = morningSlots + afternoonSlots

h = hour(time, "Asia/Tokyo")
m = minute(time, "Asia/Tokyo")
nowMin = h*60+m

getSlot() =>
    result = -1
    if nowMin >= morningStart and nowMin < morningEnd
        result := int((nowMin - morningStart) / 30)
    else if nowMin >= afternoonStart and nowMin < afternoonEnd
        result := int(morningSlots + (nowMin - afternoonStart) / 30)
    result

slot = getSlot()

var int dayCount = 0
var int lastDay = -1
today = dayofmonth + month*100 + year*10000
if today != lastDay
    dayCount := dayCount + 1
    lastDay := today

// ── 全期間累積(エントリー判定専用、表示なし) ──
var cntUp   = array.new_int(totalSlots, 0)
var cntDown = array.new_int(totalSlots, 0)
var cntAll  = array.new_int(totalSlots, 0)

// ── ローリングウィンドウ(30日: 陽陰 + 変化率) ──
// matrix・関数を使わず、平坦な配列(slot*30+位置)で保持しインライン更新する
var bufUp30  = array.new_int(totalSlots * 30, 0)
var bufChg30 = array.new_float(totalSlots * 30, 0.0)
var ptr30    = array.new_int(totalSlots, 0)
var filled30 = array.new_int(totalSlots, 0)
var up30     = array.new_int(totalSlots, 0)
var down30   = array.new_int(totalSlots, 0)
var sumChg30 = array.new_float(totalSlots, 0.0)

if barstate.isconfirmed and slot >= 0
    array.set(cntAll, slot, array.get(cntAll, slot) + 1)
    if close > open
        array.set(cntUp, slot, array.get(cntUp, slot) + 1)
    else if close < open
        array.set(cntDown, slot, array.get(cntDown, slot) + 1)

    // 30日ウィンドウ(同値の足は除外)
    if close != open
        upFlag = close > open ? 1 : 0
        chgPct = (close - open) / open * 100
        pos    = slot * 30 + array.get(ptr30, slot)
        fillN  = array.get(filled30, slot)
        if fillN >= 30
            oldUp  = array.get(bufUp30, pos)
            oldChg = array.get(bufChg30, pos)
            array.set(up30,   slot, array.get(up30, slot)   - oldUp)
            array.set(down30, slot, array.get(down30, slot) - (1 - oldUp))
            array.set(sumChg30, slot, array.get(sumChg30, slot) - oldChg)
        else
            array.set(filled30, slot, fillN + 1)
        array.set(bufUp30,  pos, upFlag)
        array.set(bufChg30, pos, chgPct)
        array.set(up30,   slot, array.get(up30, slot)   + upFlag)
        array.set(down30, slot, array.get(down30, slot) + (1 - upFlag))
        array.set(sumChg30, slot, array.get(sumChg30, slot) + chgPct)
        array.set(ptr30, slot, (array.get(ptr30, slot) + 1) % 30)

n       = slot >= 0 ? array.get(cntAll, slot) : 0
winRate = n > 0 ? array.get(cntUp, slot) / n : na

label_ = n < lookbackMinCount ? "データ不足" : winRate > 0.5 ? "上昇" : winRate < 0.5 ? "下落" : "五分五分"

bg = switch label_
    "上昇" => color.new(color.green, 40)
    "下落" => color.new(color.red, 40)
    => na

bgcolor(bg)

// ── 次の足(次スロット)の勝率で、その足の保有方向を決める ──
// 足の確定時に注文 → 次の足の始値で約定。9:00の足も前日大引けの注文で始値から保有できる。
// 大引けは immediately=true で終値約定させ、夜間は持ち越さない。
nxtSlot  = slot >= 0 ? (slot + 1) % totalSlots : -1
nxtN     = nxtSlot >= 0 ? array.get(cntAll, nxtSlot) : 0
nxtWin   = nxtN > 0 ? array.get(cntUp, nxtSlot) / nxtN : na
nxtLabel = nxtN < lookbackMinCount ? "データ不足" : nxtWin > 0.5 ? "上昇" : nxtWin < 0.5 ? "下落" : "五分五分"

if barstate.isconfirmed and slot >= 0
    if flatAtClose and slot == totalSlots - 1
        strategy.close_all(immediately=true)
    if nxtLabel == "上昇"
        strategy.entry("Long", strategy.long)
    else if nxtLabel == "下落"
        strategy.entry("Short", strategy.short)

// ── 時間帯別 損益 / プロフィットファクター ──
// 各バーの資産変動(strategy.equity の差分)を、そのバーの時間帯へ帰属させる。
// 保有ポジションの含み損益も時間帯ごとに按分され、全区間の合計は総損益(含み損益込み)と一致する。
// PF = 利益バー合計 ÷ 損失バー合計(絶対値)。Strategy Testerのトレード単位PFとは別集計。
var slotPnl = array.new_float(totalSlots, 0.0)
var slotGP  = array.new_float(totalSlots, 0.0)
var slotGL  = array.new_float(totalSlots, 0.0)

eqDelta = strategy.equity - nz(strategy.equity[1], strategy.equity)
if barstate.isconfirmed and slot >= 0
    array.set(slotPnl, slot, array.get(slotPnl, slot) + eqDelta)
    if eqDelta > 0
        array.set(slotGP, slot, array.get(slotGP, slot) + eqDelta)
    else if eqDelta < 0
        array.set(slotGL, slot, array.get(slotGL, slot) - eqDelta)

f_pnl(idx) =>
    array.get(slotPnl, idx)

f_pf(idx) =>
    gl = array.get(slotGL, idx)
    gl > 0 ? array.get(slotGP, idx) / gl : na

slotToTime(i) =>
    mins = i < morningSlots ? morningStart + i*30 : afternoonStart + (i - morningSlots)*30
    hh = int(mins / 60)
    mm = mins % 60
    str.tostring(hh) + ":" + (mm < 10 ? "0" : "") + str.tostring(mm)

f_wr30(idx) =>
    f = array.get(filled30, idx)
    f > 0 ? float(array.get(up30, idx)) / f * 100 : na

f_chg30(idx) =>
    f = array.get(filled30, idx)
    f > 0 ? array.get(sumChg30, idx) / f : na

if showTable and barstate.islast
    var table perfTable = table.new(position.top_right, 7, totalSlots + 4, border_width=1)
    table.cell(perfTable, 0, 0, "", bgcolor=color.new(color.orange,50))
    for cc = 1 to 6
        table.cell(perfTable, cc, 0, "", bgcolor=color.new(color.orange,50))

    table.cell(perfTable, 0, 1, "全期間: " + str.tostring(dayCount) + "日", bgcolor=color.new(color.orange,50), text_color=color.white)
    for cc = 1 to 6
        table.cell(perfTable, cc, 1, "", bgcolor=color.new(color.orange,50))

    table.cell(perfTable, 0, 2, "区間",        bgcolor=color.new(color.blue,70), text_color=color.white)
    table.cell(perfTable, 1, 2, "30日陽",      bgcolor=color.new(color.blue,70), text_color=color.white)
    table.cell(perfTable, 2, 2, "30日陰",      bgcolor=color.new(color.blue,70), text_color=color.white)
    table.cell(perfTable, 3, 2, "30日勝率%",   bgcolor=color.new(color.blue,70), text_color=color.white)
    table.cell(perfTable, 4, 2, "30日平均変化%", bgcolor=color.new(color.blue,70), text_color=color.white)
    table.cell(perfTable, 5, 2, "損益",        bgcolor=color.new(color.blue,70), text_color=color.white)
    table.cell(perfTable, 6, 2, "PF",          bgcolor=color.new(color.blue,70), text_color=color.white)

    for i = 0 to totalSlots - 1
        u30 = array.get(up30, i)
        d30 = array.get(down30, i)
        f30 = array.get(filled30, i)
        wr30 = f30 > 0 ? float(u30) / f30 * 100 : na
        chg30 = f30 > 0 ? array.get(sumChg30, i) / f30 : na

        bg30 = na(wr30) ? color.new(color.gray, 85) : wr30 > 50 ? color.new(color.green, 40) : wr30 < 50 ? color.new(color.red, 40) : color.new(color.orange, 40)

        entryT = slotToTime(i)
        exitT  = i < totalSlots - 1 ? slotToTime(i + 1) : "手仕舞"
        table.cell(perfTable, 0, i + 3, entryT + "→" + exitT, bgcolor=color.new(color.gray, 85), text_color=color.white)
        table.cell(perfTable, 1, i + 3, str.tostring(u30),  bgcolor=bg30, text_color=color.white)
        table.cell(perfTable, 2, i + 3, str.tostring(d30),  bgcolor=bg30, text_color=color.white)
        table.cell(perfTable, 3, i + 3, na(wr30)  ? "-" : str.tostring(wr30, "#.#"),  bgcolor=bg30, text_color=color.white)
        table.cell(perfTable, 4, i + 3, na(chg30) ? "-" : str.tostring(chg30, "#.##"), bgcolor=bg30, text_color=color.white)

        pnlI = array.get(slotPnl, i)
        glI  = array.get(slotGL, i)
        gpI  = array.get(slotGP, i)
        pfI  = glI > 0 ? gpI / glI : na
        bgPnl = pnlI > 0 ? color.new(color.green, 40) : pnlI < 0 ? color.new(color.red, 40) : color.new(color.gray, 85)
        bgPf  = na(pfI) ? color.new(color.gray, 85) : pfI > 1 ? color.new(color.green, 40) : pfI < 1 ? color.new(color.red, 40) : color.new(color.orange, 40)
        pfTxt = na(pfI) ? (gpI > 0 ? "∞" : "-") : str.tostring(pfI, "#.##")
        table.cell(perfTable, 5, i + 3, str.tostring(pnlI, "#"), bgcolor=bgPnl, text_color=color.white)
        table.cell(perfTable, 6, i + 3, pfTxt, bgcolor=bgPf, text_color=color.white)

    totPnl = array.sum(slotPnl)
    totGP  = array.sum(slotGP)
    totGL  = array.sum(slotGL)
    totPF  = totGL > 0 ? totGP / totGL : na
    for cc = 1 to 4
        table.cell(perfTable, cc, totalSlots + 3, "", bgcolor=color.new(color.gray, 85))
    table.cell(perfTable, 0, totalSlots + 3, "合計", bgcolor=color.new(color.gray, 85), text_color=color.white)
    table.cell(perfTable, 5, totalSlots + 3, str.tostring(totPnl, "#"), bgcolor=totPnl > 0 ? color.new(color.green, 40) : color.new(color.red, 40), text_color=color.white)
    table.cell(perfTable, 6, totalSlots + 3, na(totPF) ? "-" : str.tostring(totPF, "#.##"), bgcolor=color.new(color.gray, 85), text_color=color.white)

// === データウィンドウ出力(Python取得用: 30日ローリング + 時間帯別損益/PF) ===
plot(f_wr30(0),  title="30d_0900-0930 勝率%", display=display.data_window, precision=2)
plot(f_wr30(1),  title="30d_0930-1000 勝率%", display=display.data_window, precision=2)
plot(f_wr30(2),  title="30d_1000-1030 勝率%", display=display.data_window, precision=2)
plot(f_wr30(3),  title="30d_1030-1100 勝率%", display=display.data_window, precision=2)
plot(f_wr30(4),  title="30d_1100-1130 勝率%", display=display.data_window, precision=2)
plot(f_wr30(5),  title="30d_1230-1300 勝率%", display=display.data_window, precision=2)
plot(f_wr30(6),  title="30d_1300-1330 勝率%", display=display.data_window, precision=2)
plot(f_wr30(7),  title="30d_1330-1400 勝率%", display=display.data_window, precision=2)
plot(f_wr30(8),  title="30d_1400-1430 勝率%", display=display.data_window, precision=2)
plot(f_wr30(9),  title="30d_1430-1500 勝率%", display=display.data_window, precision=2)
plot(f_wr30(10), title="30d_1500-1530 勝率%", display=display.data_window, precision=2)

plot(f_chg30(0),  title="30d_0900-0930 平均変化%", display=display.data_window, precision=2)
plot(f_chg30(1),  title="30d_0930-1000 平均変化%", display=display.data_window, precision=2)
plot(f_chg30(2),  title="30d_1000-1030 平均変化%", display=display.data_window, precision=2)
plot(f_chg30(3),  title="30d_1030-1100 平均変化%", display=display.data_window, precision=2)
plot(f_chg30(4),  title="30d_1100-1130 平均変化%", display=display.data_window, precision=2)
plot(f_chg30(5),  title="30d_1230-1300 平均変化%", display=display.data_window, precision=2)
plot(f_chg30(6),  title="30d_1300-1330 平均変化%", display=display.data_window, precision=2)
plot(f_chg30(7),  title="30d_1330-1400 平均変化%", display=display.data_window, precision=2)
plot(f_chg30(8),  title="30d_1400-1430 平均変化%", display=display.data_window, precision=2)
plot(f_chg30(9),  title="30d_1430-1500 平均変化%", display=display.data_window, precision=2)
plot(f_chg30(10), title="30d_1500-1530 平均変化%", display=display.data_window, precision=2)

plot(f_pnl(0), title="pl_0900-0930 損益", display=display.data_window, precision=0)
plot(f_pnl(1), title="pl_0930-1000 損益", display=display.data_window, precision=0)
plot(f_pnl(2), title="pl_1000-1030 損益", display=display.data_window, precision=0)
plot(f_pnl(3), title="pl_1030-1100 損益", display=display.data_window, precision=0)
plot(f_pnl(4), title="pl_1100-1130 損益", display=display.data_window, precision=0)
plot(f_pnl(5), title="pl_1230-1300 損益", display=display.data_window, precision=0)
plot(f_pnl(6), title="pl_1300-1330 損益", display=display.data_window, precision=0)
plot(f_pnl(7), title="pl_1330-1400 損益", display=display.data_window, precision=0)
plot(f_pnl(8), title="pl_1400-1430 損益", display=display.data_window, precision=0)
plot(f_pnl(9), title="pl_1430-1500 損益", display=display.data_window, precision=0)
plot(f_pnl(10), title="pl_1500-1530 損益", display=display.data_window, precision=0)

plot(f_pf(0), title="pf_0900-0930 PF", display=display.data_window, precision=2)
plot(f_pf(1), title="pf_0930-1000 PF", display=display.data_window, precision=2)
plot(f_pf(2), title="pf_1000-1030 PF", display=display.data_window, precision=2)
plot(f_pf(3), title="pf_1030-1100 PF", display=display.data_window, precision=2)
plot(f_pf(4), title="pf_1100-1130 PF", display=display.data_window, precision=2)
plot(f_pf(5), title="pf_1230-1300 PF", display=display.data_window, precision=2)
plot(f_pf(6), title="pf_1300-1330 PF", display=display.data_window, precision=2)
plot(f_pf(7), title="pf_1330-1400 PF", display=display.data_window, precision=2)
plot(f_pf(8), title="pf_1400-1430 PF", display=display.data_window, precision=2)
plot(f_pf(9), title="pf_1430-1500 PF", display=display.data_window, precision=2)
plot(f_pf(10), title="pf_1500-1530 PF", display=display.data_window, precision=2)
